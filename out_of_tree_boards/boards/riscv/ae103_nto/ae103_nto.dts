/dts-v1/;

#include <spksilicon/ae103.dtsi>

/ {
	model = "SPK32 AE103 NTO";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
	};
};

&cpu0 {
	clock-frequency = <48000000>;
	status = "okay";
};
