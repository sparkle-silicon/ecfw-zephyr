/dts-v1/;

#include <spksilicon/ae103.dtsi>

/ {
	model = "SPK32 AE103 NTO";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
	};

	aliases {
	};
};

&cpu0 {
	clock-frequency = <48000000>;
	status = "okay";
};

/*
 * Debug console：UART0（8x 过采样，非标），对齐裸机固件 debug 口
 * （KERNEL_SOC_FUNC.c serial_init(0, UART0_BAUD)）。
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};
